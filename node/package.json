{
  "name": "fast-uuid-v7",
  "version": "0.1.10",
  "description": "Fast UUID v7 generator for Node.js, backed by the fast-uuid-v7 Rust crate.",
  "keywords": [
    "uuid",
    "uuidv7",
    "uuid7",
    "guid",
    "id",
    "napi",
    "rust"
  ],
  "homepage": "https://github.com/marcomq/fast-uuid-v7/tree/main/node#readme",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomq/fast-uuid-v7.git",
    "directory": "node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "fast_uuid_v7",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --strip --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "test": "node --test",
    "bench": "node bench/bench.mjs",
    "sync-version": "node sync-version.mjs",
    "create-npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts"
  },
  "optionalDependencies": {
    "fast-uuid-v7-darwin-x64": "0.1.10",
    "fast-uuid-v7-darwin-arm64": "0.1.10",
    "fast-uuid-v7-linux-x64-gnu": "0.1.10",
    "fast-uuid-v7-linux-arm64-gnu": "0.1.10",
    "fast-uuid-v7-win32-x64-msvc": "0.1.10"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "uuid": "^14.0.3",
    "uuidv7": "^1.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
